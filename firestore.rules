rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEAMCODE durch den echten Teamcode ersetzen (nur in der Firebase Console, nicht im Repo)
    match /teams/{team} {
      allow get: if team == 'TEAMCODE';
      allow create, update: if team == 'TEAMCODE'
        && request.resource.data.keys().hasOnly(['version', 'members', 'history', 'current']);
      allow list, delete: if false;
    }
  }
}
